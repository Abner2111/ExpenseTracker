[Unit]
Description=ExpenseTracker - BAC Credomatic email to Google Sheets sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CHANGE_ME_username
WorkingDirectory=/home/CHANGE_ME_username/ExpenseTracker/src
ExecStart=/home/CHANGE_ME_username/ExpenseTracker/.venv/bin/python main.py
TimeoutStartSec=300
