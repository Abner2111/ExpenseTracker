{"nodes": [{"id": "roadmap_phase1_correctness_reliability", "label": "Phase 1: Correctness & Reliability", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_idempotency_duplicate_prevention", "label": "Idempotency / Duplicate Prevention (1.1)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flagged as the single highest-risk issue: re-running the app currently creates duplicate rows in Sheets because there is no record of already-processed emails."}, {"id": "roadmap_processed_emails_table", "label": "processed_emails table", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_remove_hardcoded_configs", "label": "Remove All Hardcoded Configs (1.2)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_filter_by_month_config", "label": "FILTER_BY_MONTH hardcoded config", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoded to \"2025/09\" and outdated; should default to the current month or None."}, {"id": "roadmap_fallback_exchange_rates", "label": "Fallback exchange rates in config_manager.py", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rates are ~5-10% off vs 2026 rates; needs a scheduled refresh or a user-editable config.json instead of source-code changes."}, {"id": "roadmap_config_json", "label": "config.json (proposed)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_date_parsing_fallback_bug", "label": "Date Parsing Fallback Bug (1.3)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "date_parser.py silently falls back to today's date when parsing fails, assigning the wrong date to an expense instead of raising an error; should raise ExpenseParsingError with the unparsed string."}, {"id": "roadmap_expenseparsingerror", "label": "ExpenseParsingError", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_retry_logic", "label": "Retry Logic for Transient Failures (1.4)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gmail and Sheets API calls have no retry, so a single rate-limit response or timeout silently fails the expense; propose exponential backoff (3 attempts)."}, {"id": "roadmap_fetch_bac_emails", "label": "fetch_bac_emails()", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_add_expense", "label": "add_expense()", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_phase2_robustness_observability", "label": "Phase 2: Robustness & Observability", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_structured_transaction_log", "label": "Structured Transaction Log (2.1)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_processing_log_table", "label": "processing_log table", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_specific_error_types", "label": "Specific Error Types (2.2)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A generic \"Failed to parse email\" message tells you nothing; splitting into specific error types surfaces the actual failure reason in the GUI status panel and log."}, {"id": "roadmap_amountnotfounderror", "label": "AmountNotFoundError", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_vendornotfounderror", "label": "VendorNotFoundError", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_datenotfounderror", "label": "DateNotFoundError", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_rate_limiting_awareness", "label": "Rate Limiting Awareness (2.3)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The current 0.5s fixed delay ignores HTTP 429 responses; propose checking status codes and backing off dynamically, plus tracking calls toward exchangerate-api.com's 1500/month limit."}, {"id": "roadmap_metrics_dashboard", "label": "Metrics Dashboard GUI tab (2.4)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_phase3_configuration_ux", "label": "Phase 3: Configuration & UX", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_persist_gui_config", "label": "Persist GUI Config (3.1)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Config changes in the GUI aren't saved and reset on next launch; propose writing to config.json on Save and loading it at startup, falling back to config.py defaults."}, {"id": "roadmap_configurable_sheets_columns", "label": "Configurable Sheets Columns (3.2)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Column range B:E is hardcoded in sheets_manager.py; propose a configurable column mapping."}, {"id": "roadmap_column_mapping_config", "label": "Column mapping config", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_email_recovery_mode", "label": "Email Recovery Mode (3.3)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only unread emails are fetched; if one was marked read prematurely it's unrecoverable. Propose a reprocess date-range option using Gmail after:/before: queries, skipping already-logged email IDs."}, {"id": "roadmap_multi_bank_support", "label": "Multi-Bank / Multi-Account Support (3.4)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Gmail query is hardcoded to BAC Credomatic's sender/subject; refactor into a BankProfile configuration stored in the database so a second bank can be added without changing source code."}, {"id": "roadmap_bankprofile", "label": "BankProfile configuration", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_phase4_code_quality_maintainability", "label": "Phase 4: Code Quality & Maintainability", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_test_coverage", "label": "Test Coverage (4.1)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most files under test/ are empty stubs; priority order is date_parser (6 format patterns + Spanish months), expense_parser (8 amount regex patterns), currency_converter (caching, fallback, API failure), using pytest + unittest.mock to avoid real credentials."}, {"id": "roadmap_remove_dead_code", "label": "Remove Dead Code (4.2)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_main_old_py", "label": "src/main_old.py", "file_type": "code", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_main_refactored_py", "label": "src/main_refactored.py", "file_type": "code", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_batch_add_expenses", "label": "batch_add_expenses()", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_secrets_out_of_source_tree", "label": "Secrets Out of Source Tree (4.3)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/credentials.json should not be committed; add it to .gitignore and provide a credentials.json.example template, and document the OAuth setup in README."}, {"id": "roadmap_credentials_json_example", "label": "credentials.json.example", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_config_py_to_json_migration", "label": "config.py to config.json migration (4.4)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Having user-specific values (Spreadsheet ID, month filter) in a .py file means any edit is a code change; migrate to a config.json in the project root, editable without touching Python files."}, {"id": "roadmap_phase5_future_capabilities", "label": "Phase 5: Future Capabilities", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_budget_tracking", "label": "Budget Tracking (5.1)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_budgets_table", "label": "budgets table", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_export_feature", "label": "Export feature (5.2)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_scheduled_background_mode", "label": "Scheduled / Background Mode (5.3)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_category_rule_editor_gui", "label": "Category Rule Editor in GUI (5.4)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding/editing categorization rules currently requires the admin_database.py CLI or direct SQLite access; a CRUD table in the Config tab would make the app self-contained for non-technical users."}, {"id": "roadmap_priority_summary_table", "label": "Priority Summary table", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_exchangerate_api_limit", "label": "exchangerate-api.com 1500/month limit", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "roadmap_phase1_correctness_reliability", "target": "roadmap_idempotency_duplicate_prevention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "roadmap_phase1_correctness_reliability", "target": "roadmap_remove_hardcoded_configs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "roadmap_phase1_correctness_reliability"